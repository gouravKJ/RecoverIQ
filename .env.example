# Server
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Frontend (public only)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Database
DATABASE_URL=postgresql://recoveriq:recoveriq@localhost:5432/recoveriq

# Razorpay Test Mode (server-side only)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxx

# Execution
EXECUTOR_MODE=hybrid
DEMO_FORCE_SCENARIO_OUTCOMES=true

# Optional
WEBHOOK_STALE_EVENT_SECONDS=300
LOG_LEVEL=info
